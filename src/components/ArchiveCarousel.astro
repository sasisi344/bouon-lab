---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { resolvePostCover } from '../data/categoryDefaultCover';
import { resolvePostSlugSegment } from '../utils/resolvePostSlugSegment';

const {
  subcategory,
  allPosts: providedPosts,
  relatedPosts: providedRelated,
  lang = 'ja',
  limitByDevice = false,
  trackEvent = 'related_click',
  trackSource = 'related_carousel'
} = Astro.props;

type CarouselItem = {
  post?: any;
  relationLabel?: string;
  relationKey?: string;
  data?: any;
  id?: string;
  collection?: string;
};

let filtered: CarouselItem[];

if (providedRelated) {
  // relatedPosts が直接渡された場合（記事末尾など）はそのまま使う
  filtered = providedRelated;
} else {
  // コレクションから取得してフィルタリング
  let allPosts = providedPosts;
  if (!allPosts) {
    allPosts = (await getCollection('posts'))
      .filter((post) => post.data.draft !== true);
  }

  // Filter posts for this specific subcategory AND matching language
  // 更新日の新しい順で安定表示
  filtered = allPosts
    .filter((p: any) => 
      p.data.subcategory === subcategory && 
      (p.data.lang || 'ja') === lang &&
      !p.id.endsWith('/index')
    )
    .sort((a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 12);
}

function getUrl(post: any) {
    const postLang = post.data.lang || 'ja';
    const segment = post.data.category;
    const slug = resolvePostSlugSegment(post);
    return slug ? `/${postLang}/${segment}/${slug}/` : `/${postLang}/${segment}/`;
}
---

{filtered.length > 0 && (
  <div class={`archive-carousel ${limitByDevice ? 'is-limited' : ''}`} data-carousel>
    <div class="carousel-viewport" data-viewport>
      <div class="carousel-track">
        {filtered.map((item) => {
          const entry = item.post ?? item;
          const relationLabel = item.relationLabel;
          const relationKey = item.relationKey;
          return (
          <article class="carousel-card">
            <a
              href={getUrl(entry)}
              class="card-link-overlay"
              aria-label={entry.data.title}
              data-track-event={trackEvent}
              data-track-source={trackSource}
              data-track-label={entry.data.title}
            ></a>
            <div class="card-image">
              <Image src={resolvePostCover(entry)} alt="" width={400} height={225} format="webp" />
            </div>
            <div class="card-body">
              <div class="card-meta">
                <span class="date">{entry.data.date.toLocaleDateString(lang === 'ja' ? 'ja-JP' : 'en-US')}</span>
                {relationLabel && <span class={`relation-label ${relationKey || ''}`}>{relationLabel}</span>}
              </div>
              <h4 class="card-title">{entry.data.title}</h4>
              <p class="card-excerpt">{entry.data.description.length > 50 ? entry.data.description.substring(0, 50) + "..." : entry.data.description}</p>
            </div>
          </article>
        )})}
      </div>
    </div>
    
    <div class="carousel-nav">
      <button class="nav-btn prev" data-prev aria-label="Previous">
        <svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>
      <button class="nav-btn next" data-next aria-label="Next">
        <svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </button>
    </div>
  </div>
)}

<style>
  .archive-carousel {
    position: relative;
    margin: 2rem 0 4rem;
    padding: 0 1rem;
  }

  .carousel-viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }

  .carousel-viewport::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    padding-bottom: 1rem;
  }

  .carousel-card {
    flex: 0 0 calc(33.333% - 1rem);
    min-width: 280px;
    scroll-snap-align: start;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), border-color 0.3s;
    display: flex;
    flex-direction: column;
  }

  .carousel-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary-gold);
    background: rgba(255, 255, 255, 0.05);
  }

  .card-link-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .carousel-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.05rem;
  }

  .relation-label {
    border: 1px solid rgba(212, 175, 55, 0.35);
    color: var(--primary-gold);
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .card-title {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
    color: #fff;
    font-family: var(--font-ud-mincho);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-excerpt {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-dim);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Navigation Buttons */
  .carousel-nav {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 1rem;
  }

  .nav-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-dim);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
  }

  .nav-btn:hover {
    background: var(--primary-gold);
    color: #000;
    border-color: var(--primary-gold);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
  }

  @media (max-width: 1024px) {
    .archive-carousel.is-limited .carousel-card:nth-child(n+7) {
      display: none;
    }

    .carousel-card {
      flex: 0 0 calc(50% - 0.75rem);
    }
  }

  @media (max-width: 640px) {
    .archive-carousel.is-limited .carousel-card:nth-child(n+4) {
      display: none;
    }

    .carousel-card {
      flex: 0 0 85%;
    }
    .carousel-nav {
      display: none; /* Hide buttons on mobile, use native scroll */
    }
    .archive-carousel {
       padding: 0; /* Full width on mobile */
    }
  }
</style>

<script>
  function initCarousels() {
    const carousels = document.querySelectorAll('[data-carousel]');
    
    carousels.forEach(carousel => {
      const viewport = carousel.querySelector('[data-viewport]');
      const nextBtn = carousel.querySelector('[data-next]');
      const prevBtn = carousel.querySelector('[data-prev]');
      
      if (!viewport || !nextBtn || !prevBtn) return;
      
      const scrollAmount = () => {
        const card = viewport.querySelector('.carousel-card');
        return card ? card.clientWidth + 24 : 300; // card width + gap
      };

      nextBtn.addEventListener('click', () => {
        viewport.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });

      prevBtn.addEventListener('click', () => {
        viewport.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });
    });
  }

  // Handle both initial load and view transitions
  initCarousels();
  document.addEventListener('astro:after-swap', initCarousels);
</script>
