---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { resolvePostCover } from '../data/categoryDefaultCover';
import { resolvePostSlugSegment } from '../utils/resolvePostSlugSegment';

const {
  subcategory,
  allPosts: providedPosts,
  relatedPosts: providedRelated,
  lang = 'ja',
  limitByDevice = false,
  trackEvent = 'related_click',
  trackSource = 'related_carousel'
} = Astro.props;

type CarouselItem = {
  post?: any;
  relationLabel?: string;
  relationKey?: string;
  data?: any;
  id?: string;
  collection?: string;
};

let filtered: CarouselItem[];

if (providedRelated) {
  filtered = providedRelated;
} else {
  let allPosts = providedPosts;
  if (!allPosts) {
    allPosts = (await getCollection('posts'))
      .filter((post) => post.data.draft !== true);
  }

  filtered = allPosts
    .filter((p: any) =>
      p.data.subcategory === subcategory &&
      (p.data.lang || 'ja') === lang &&
      !p.id.endsWith('/index')
    )
    .sort((a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 6); // 最大6件固定
}

function getUrl(post: any) {
  const postLang = post.data.lang || 'ja';
  const segment = post.data.category;
  const slug = resolvePostSlugSegment(post);
  return slug ? `/${postLang}/${segment}/${slug}/` : `/${postLang}/${segment}/`;
}
---

{filtered.length > 0 && (
  <div class="archive-carousel" data-carousel>
    <div class="carousel-viewport" data-viewport>
      <div class="carousel-track">
        {filtered.map((item) => {
          const entry = item.post ?? item;
          const relationLabel = item.relationLabel;
          const relationKey = item.relationKey;
          return (
            <article class="carousel-card">
              <a
                href={getUrl(entry)}
                class="card-link-overlay"
                aria-label={entry.data.title}
                data-track-event={trackEvent}
                data-track-source={trackSource}
                data-track-label={entry.data.title}
              ></a>
              <div class="card-image">
                <Image src={resolvePostCover(entry)} alt="" width={400} height={225} format="webp" />
              </div>
              <div class="card-body">
                <div class="card-meta">
                  <span class="date">{entry.data.date.toLocaleDateString(lang === 'ja' ? 'ja-JP' : 'en-US')}</span>
                  {relationLabel && <span class={`relation-label ${relationKey || ''}`}>{relationLabel}</span>}
                </div>
                <h4 class="card-title">{entry.data.title}</h4>
                <p class="card-excerpt">{entry.data.description.length > 50 ? entry.data.description.substring(0, 50) + '...' : entry.data.description}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <div class="carousel-nav">
      <button class="nav-btn prev" data-prev aria-label="Previous">
        <svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>
      <button class="nav-btn next" data-next aria-label="Next">
        <svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </button>
    </div>
  </div>
)}

<style>
  .archive-carousel {
    position: relative;
    margin: 2rem 0 4rem;
  }

  /* ── スクロール領域 ── */
  .carousel-viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* スナップ位置を padding と一致させる */
    padding: 0 1rem;
    scroll-padding-left: 1rem;
  }

  .carousel-viewport::-webkit-scrollbar {
    display: none;
  }

  /* ── カードトラック ── */
  .carousel-track {
    display: flex;
    align-items: stretch; /* 全カードを同一高さに揃える */
    gap: 1rem;
  }

  /* ── カード ── */
  .carousel-card {
    /* PC: 3枚 */
    flex: 0 0 calc(33.333% - 0.68rem);
    min-width: 220px;
    scroll-snap-align: start;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275),
                border-color 0.3s;
  }

  .carousel-card:hover {
    transform: translateY(-4px);
    border-color: var(--sl-color-accent);
    background: rgba(255, 255, 255, 0.05);
  }

  .card-link-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  /* ── 画像エリア（アスペクト比固定） ── */
  .card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0; /* 画像エリアが縮まないよう固定 */
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
    display: block; /* inline のデフォルト隙間を除去 */
  }

  .carousel-card:hover .card-image img {
    transform: scale(1.05);
  }

  /* ── カード本文（残り高さを埋める） ── */
  .card-body {
    flex: 1;
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
    letter-spacing: 0.04rem;
  }

  .relation-label {
    border: 1px solid rgba(201, 168, 48, 0.35);
    color: var(--sl-color-accent);
    border-radius: 999px;
    padding: 0.1rem 0.45rem;
    font-size: 0.65rem;
    white-space: nowrap;
  }

  .card-title {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--sl-color-white);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-excerpt {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--sl-color-gray-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── ナビゲーションボタン ── */
  .carousel-nav {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding: 0 1rem;
  }

  .nav-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--sl-color-gray-3);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s;
  }

  .nav-btn:hover {
    background: var(--sl-color-accent);
    color: #000;
    border-color: var(--sl-color-accent);
  }

  /* ── タブレット: 2枚 ── */
  @media (max-width: 1024px) {
    .carousel-card {
      flex: 0 0 calc(50% - 1rem);
      min-width: 0;
    }
  }

  /* ── スマートフォン: 1.1枚ぶん（次を少し見せる） ── */
  @media (max-width: 640px) {
    .carousel-viewport {
      /* padding-left で左余白を確保し scroll-padding-left と同期 */
      padding: 0 0.75rem;
      scroll-padding-left: 0.75rem;
    }

    .carousel-card {
      /* 左余白(0.75rem)を引いた残り幅 ≒ カード1枚 + 次のカードが少し見える */
      flex: 0 0 calc(100% - 2.5rem);
      min-width: 0;
    }

    .carousel-nav {
      display: none; /* モバイルはネイティブスクロールで操作 */
    }
  }
</style>

<script>
  function initCarousels() {
    const carousels = document.querySelectorAll('[data-carousel]');

    carousels.forEach(carousel => {
      const viewport = carousel.querySelector('[data-viewport]') as HTMLElement | null;
      const nextBtn = carousel.querySelector('[data-next]');
      const prevBtn = carousel.querySelector('[data-prev]');

      if (!viewport || !nextBtn || !prevBtn) return;

      const scrollAmount = () => {
        const card = viewport.querySelector('.carousel-card') as HTMLElement | null;
        return card ? card.offsetWidth + 16 : 280; // カード幅 + gap(1rem=16px)
      };

      nextBtn.addEventListener('click', () => {
        viewport.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });

      prevBtn.addEventListener('click', () => {
        viewport.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });
    });
  }

  initCarousels();
  document.addEventListener('astro:after-swap', initCarousels);
</script>
