---
import { getCollection } from 'astro:content';
import { resolvePostSlugSegment } from '../utils/resolvePostSlugSegment';

interface Props {
  slug: string;
  className?: string;
}

const { slug, className } = Astro.props;

// 全記事から対象のslug（frontmatter slug優先、次点でid末尾）を探す
const allPosts = (await getCollection('posts'))
  .filter((post) => post.data.draft !== true);

// MDXから現在の言語を取得（propsとして渡す運用にするのが確実）
// もしくは全記事から「指定したスラッグ かつ 現在のURLに含まれる言語」を優先して探す
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith('/en') ? 'en' : 'ja';

const post = allPosts.find((p) => {
  const lang = p.data.lang || 'ja';
  const preferredSlug = p.data.slug?.trim();
  const idTail = p.id.split('/').pop();
  const isSlugMatch = preferredSlug === slug || idTail === slug;
  return isSlugMatch && lang === currentLang;
});

// 多言語対応パスの解決: /[lang]/[collection]/[slug]/
let url = '#';
if (post) {
    const lang = post.data.lang || 'ja';
    const category = post.data.category;
    const segment = resolvePostSlugSegment(post);
    url = segment ? `/${lang}/${category}/${segment}/` : '#';
}

if (!post && slug !== "index" && slug !== "") {
  console.warn(`[SmartLink] Warning: Slug "${slug}" not found in language "${currentLang}".`);
}
---
<a href={url} class={className}>
  <slot>{post ? post.data.title : slug}</slot>
</a>
