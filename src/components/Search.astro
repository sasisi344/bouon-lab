---
const { lang = 'ja' } = Astro.props;

const placeholders = {
  ja: '防音室、DIY、吸音材...',
  en: 'Soundproof booth, DIY, acoustic materials...'
};

const labels = {
  ja: {
    title: '記事を検索',
    noResults: '該当する記事が見つかりませんでした。',
    close: '閉じる'
  },
  en: {
    title: 'Search Articles',
    noResults: 'No articles found matching your query.',
    close: 'Close'
  }
};
---

<div class="search-container">
  <button id="search-open-btn" class="search-trigger" aria-label="Search">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span class="search-label d-none-mobile">{lang === 'ja' ? '検索' : 'Search'}</span>
  </button>

  <div id="search-modal" class="search-modal">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h2>{labels[lang].title}</h2>
        <button id="search-close-btn" class="close-btn" aria-label="Close">&times;</button>
      </div>
      
      <div class="search-input-wrapper">
        <input 
          type="text" 
          id="search-input" 
          placeholder={placeholders[lang]} 
          autocomplete="off"
        />
        <div id="search-loading" class="spinner" style="display: none;"></div>
      </div>

      <div id="search-results" class="results-container">
        <!-- Results will be injected here -->
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ lang, noResultsLabel: labels[lang].noResults }}>
  let searchIndex = null;
  const openBtn = document.getElementById('search-open-btn');
  const closeBtn = document.getElementById('search-close-btn');
  const modal = document.getElementById('search-modal');
  const backdrop = modal?.querySelector('.modal-backdrop');
  const input = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');
  const loading = document.getElementById('search-loading');

  function openModal() {
    modal?.classList.add('is-active');
    document.body.style.overflow = 'hidden';
    setTimeout(() => input?.focus(), 100);
    loadIndex();
  }

  function closeModal() {
    modal?.classList.remove('is-active');
    document.body.style.overflow = '';
  }

  async function loadIndex() {
    if (searchIndex) return;
    loading.style.display = 'block';
    try {
      const response = await fetch('/api/search.json');
      searchIndex = await response.json();
    } catch (e) {
      console.error('Failed to load search index:', e);
    } finally {
      loading.style.display = 'none';
    }
  }

  function performSearch(query) {
    if (!searchIndex || !query.trim()) {
      resultsContainer.innerHTML = '';
      return;
    }

    const q = query.toLowerCase();
    const results = searchIndex.filter(item => 
      item.lang === lang && 
      (item.title.toLowerCase().includes(q) || 
       item.description.toLowerCase().includes(q) || 
       item.category.toLowerCase().includes(q) ||
       item.tags.some(t => t.toLowerCase().includes(q)))
    );

    renderResults(results);
  }

  function renderResults(results) {
    if (results.length === 0) {
      resultsContainer.innerHTML = `<p class="no-results">${noResultsLabel}</p>`;
      return;
    }

    resultsContainer.innerHTML = results.map(item => `
      <a href="${item.url}" class="search-result-item">
        <div class="result-category">${item.category}</div>
        <div class="result-title">${item.title}</div>
        <div class="result-desc">${item.description.substring(0, 100)}...</div>
      </a>
    `).join('');
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);

  input?.addEventListener('input', (e) => {
    performSearch(e.target.value);
  });

  // Shortcut key (CMD+K or /)
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openModal();
    }
    if (e.key === '/' && document.activeElement.tagName !== 'INPUT') {
      e.preventDefault();
      openModal();
    }
    if (e.key === 'Escape') {
      closeModal();
    }
  });
</script>

<style>
  .search-trigger {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-dim);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s;
    font-size: 0.85rem;
    font-weight: bold;
    font-family: var(--font-ud-gothic);
  }

  .search-trigger:hover {
    border-color: var(--primary-gold);
    color: var(--primary-gold);
    background: rgba(212, 175, 55, 0.05);
  }

  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
  }

  .search-modal.is-active {
    opacity: 1;
    visibility: visible;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
  }

  .modal-content {
    position: relative;
    z-index: 1;
    width: 90%;
    max-width: 700px;
    background: var(--bg-mocha);
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 16px;
    padding: 2rem;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.8);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--primary-gold);
    letter-spacing: 0.1rem;
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 2rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }

  .search-input-wrapper {
    position: relative;
    margin-bottom: 2rem;
  }

  #search-input {
    width: 100%;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 1.2rem 1.5rem;
    color: #fff;
    font-size: 1.1rem;
    font-family: var(--font-ud-gothic);
  }

  #search-input:focus {
    outline: none;
    border-color: var(--primary-gold);
    box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.1);
  }

  .results-container {
    overflow-y: auto;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-result-item {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    text-decoration: none;
    transition: all 0.3s;
  }

  .search-result-item:hover {
    background: rgba(212, 175, 55, 0.05);
    border-color: var(--primary-gold);
    transform: translateX(5px);
  }

  .result-category {
    font-size: 0.7rem;
    color: var(--primary-gold);
    letter-spacing: 0.1rem;
    margin-bottom: 0.5rem;
  }

  .result-title {
    font-family: var(--font-ud-mincho);
    font-size: 1.1rem;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .result-desc {
    font-size: 0.85rem;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .no-results {
    text-align: center;
    color: var(--text-dim);
    margin-top: 3rem;
  }

  .spinner {
    position: absolute;
    right: 1.5rem;
    top: 1.3rem;
    width: 20px;
    height: 20px;
    border: 2px solid rgba(212, 175, 55, 0.3);
    border-top-color: var(--primary-gold);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .d-none-mobile { display: none; }
    .modal-content { padding: 1.5rem; width: 95%; height: 90vh; }
  }
</style>
