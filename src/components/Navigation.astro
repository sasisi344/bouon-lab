---
import Search from './Search.astro';
import {
  topCategoriesForLang,
  labelForCategory,
} from '../data/contentCategories';

const pathname = Astro.url.pathname;
const lang = pathname.startsWith('/en') ? 'en' : 'ja';
const normalizedPath = pathname.endsWith('/') ? pathname : `${pathname}/`;

const directoryCats = topCategoriesForLang(lang);
const navItems = [
  { href: `/${lang}/`, label: lang === 'ja' ? 'トップ' : 'Home', match: 'exact' as const },
  ...directoryCats.map((cat) => ({
    href: `/${lang}/${cat}/`,
    label: labelForCategory(cat, lang),
    match: 'prefix' as const,
  })),
  { href: `/${lang}/about/`, label: 'ABOUT', match: 'exact' as const },
];

const isActive = (item: (typeof navItems)[number]) =>
  item.match === 'prefix'
    ? normalizedPath.startsWith(item.href)
    : normalizedPath === item.href;
---

<header class="site-header">
  <div class="header-container">
    <a href={`/${lang}/`} class="logo">
      <span class="logo-text">防音Lab</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="desktop-nav">
      {navItems.map(item => (
        <a href={item.href} class={isActive(item) ? 'active' : ''}>{item.label}</a>
      ))}
      <div class="search-nav-item">
        <Search lang={lang} />
      </div>
    </nav>

    <!-- Hamburger Toggle -->
    <button id="menu-toggle" class="hamburger" aria-label="Menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="mobile-menu-overlay">
    <nav class="mobile-nav">
      <div class="search-mobile-wrapper">
        <Search lang={lang} />
      </div>
      {navItems.map(item => (
        <a href={item.href} class={isActive(item) ? 'active' : ''}>{item.label}</a>
      ))}
      <div class="lang-switch">
         <a href={lang === 'ja' ? pathname.replace('/ja', '/en') : pathname.replace('/en', '/ja')} class="lang-btn">
            {lang === 'ja' ? 'English' : '日本語'}
         </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const body = document.body;

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      toggle.classList.toggle('is-active');
      menu.classList.toggle('is-active');
      body.classList.toggle('menu-open');
    });

    // リンククリック時に閉じる
    const links = menu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        toggle.classList.remove('is-active');
        menu.classList.remove('is-active');
        body.classList.remove('menu-open');
      });
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(13, 11, 10, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    height: 70px;
    display: flex;
    align-items: center;
  }

  .header-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    text-decoration: none;
    font-family: var(--font-ud-mincho);
    font-weight: bold;
    font-size: 1.4rem;
    color: var(--primary-gold);
    letter-spacing: 0.1rem;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: flex;
    gap: 2rem;
  }

  .desktop-nav a {
    color: var(--text-dim);
    font-size: 0.85rem;
    font-weight: bold;
    letter-spacing: 0.1rem;
    text-decoration: none;
    transition: color 0.3s;
  }

  .desktop-nav a:hover, .desktop-nav a.active {
    color: var(--primary-gold);
  }

  .search-nav-item {
    display: flex;
    align-items: center;
    margin-left: 1rem;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    cursor: pointer;
    background: none;
    border: none;
    padding: 10px;
    z-index: 1100;
  }

  .bar {
    display: block;
    width: 25px;
    height: 2px;
    margin: 5px auto;
    background-color: var(--primary-gold);
    transition: all 0.3s ease-in-out;
  }

  /* Mobile Menu Overlay */
  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: #0D0B0A;
    z-index: 1050;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .mobile-menu-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  .mobile-nav a {
    font-family: var(--font-ud-mincho);
    font-size: 2rem;
    color: #fff;
    text-decoration: none;
    transition: color 0.3s;
  }

  .mobile-nav a:hover, .mobile-nav a.active {
    color: var(--primary-gold);
  }

  .lang-switch {
    margin-top: 2rem;
  }

  .lang-btn {
    padding: 0.8rem 2rem;
    border: 1px solid var(--primary-gold);
    border-radius: 50px;
    color: var(--primary-gold) !important;
    font-size: 1rem !important;
  }

  /* Animation */
  .hamburger.is-active .bar:nth-child(2) { opacity: 0; }
  .hamburger.is-active .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.is-active .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 768px) {
    .desktop-nav { display: none; }
    .hamburger { display: block; }
  }
</style>
