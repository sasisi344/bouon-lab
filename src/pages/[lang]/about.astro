---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

export async function getStaticPaths() {
    return [
        { params: { lang: 'ja' } },
    ];
}

const { lang } = Astro.params;

const content = {
    ja: {
        title: "ABOUT | 防音Lab",
        heading: "高い技術を、あなたの住まいへ。",
        subheading: "防音Lab（BouonLab）とは",
        text: "防音Labは、日本の防音技術は世界でも高い水準にあるのに、一般の住宅や賃貸には十分届いていない——そんなギャップに向き合うメディアです。あなたの住まい・予算・用途に合わせて、今すぐ試せる対策から本格的な選択肢まで案内します。",
        mission_title: "運営ミッション",
        mission_text: "スタジオや商業施設で培われた防音の知見を、在宅ワーク・楽器練習・配信・騒音トラブルといった、身近な悩みに落とし込むこと。専門用語だけで終わらせず、「自分の環境なら何から始めるか」が分かる情報を届けます。",
        features: [
            {
                title: "あなたの環境に合わせた案内",
                body: "賃貸か持ち家か、予算はいくらか、何のために静かにしたいか——状況が違えば最適解も変わります。防音Labは、一律の答えではなく、あなたの条件に近い記事と選択肢から読み始められるよう整理しています。"
            },
            {
                title: "住宅に届いていない技術を橋渡しする",
                body: "日本には優れた防音メーカー、防音賃貸、補助金制度、地域の物件情報があります。一方で、一般住宅の間取りや生活音の実態には、そのままでは当てはまりません。現場で使われている技術を、住まいの文脈で理解できる形に翻訳します。"
            },
            {
                title: "トラブル前の予防と、困ったときの道筋",
                body: "騒音は我慢の問題だけではなく、近隣関係や契約、費用の問題でもあります。苦情が来る前にできること、トラブルが起きたときの進め方、費用の見通しまで、実生活で使える情報をまとめています。"
            }
        ]
    },
    en: {
        title: "ABOUT | BouonLab",
        heading: "Bringing advanced soundproofing home.",
        subheading: "What is BouonLab?",
        text: "BouonLab focuses on a gap in Japan: world-class soundproofing exists, yet ordinary apartments and houses rarely benefit from it. We help you find practical steps that fit your home, budget, and daily life.",
        mission_title: "Our Mission",
        mission_text: "Translate studio-grade and commercial acoustic know-how into everyday problems—remote work, practice, streaming, and neighbor noise—so readers know what to try first in their own situation.",
        features: [
            {
                title: "Guidance for your situation",
                body: "Rent or own, budget, and purpose all change the answer. BouonLab organizes articles so you can start from conditions close to yours, not a one-size-fits-all recommendation."
            },
            {
                title: "Bridging tech to housing",
                body: "Japan has strong manufacturers, soundproof rentals, subsidies, and regional guides—but standard homes need a different lens. We explain professional solutions in the context of where people actually live."
            },
            {
                title: "Prevention and next steps",
                body: "Noise issues touch neighbors, contracts, and cost—not just volume. We cover what to do before complaints arise, how to respond when trouble starts, and how to plan expenses."
            }
        ]
    }
};

const t = content[lang as keyof typeof content];
---

<StarlightPage frontmatter={{ title: t.title, description: t.text, head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex,follow' } }] }} hasSidebar={false}>
    <main class="page-container">
        <header class="page-header">
            <div class="eyebrow-box">
                <div class="line"></div>
                <span class="eyebrow">ABOUT US</span>
                <div class="line"></div>
            </div>
            <h1>{t.heading}</h1>
            <p class="intro-text-large">{t.text}</p>
        </header>

        <section class="page-content">
            <div class="mission-section">
                <h2>{t.mission_title}</h2>
                <p>{t.mission_text}</p>
            </div>

            <div class="feature-grid">
                {t.features.map(feature => (
                    <div class="feature-card">
                        <h3>{feature.title}</h3>
                        <p>{feature.body}</p>
                    </div>
                ))}
            </div>

            <aside class="identity-card">
                <div class="card-content">
                    <div class="author-row">
                        <svg class="author-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M4 20c0-4 3.582-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        <span class="author-name">さしし</span>
                        <div class="author-links">
                            <a href="https://x.com/sasisi344" target="_blank" rel="noopener noreferrer" class="author-link">
                                <svg class="x-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                </svg>
                                @sasisi344
                            </a>
                            <span class="author-sep">·</span>
                            <a href="https://4thavenue.info" target="_blank" rel="noopener noreferrer" class="author-link">4thavenue.info</a>
                        </div>
                    </div>
                    <h4>このサイトについて</h4>
                    <p>
                        私は防音の専門家ではありませんが、防音・音響に関する知識を持ち、徹底したリサーチを得意としています。そのような背景から、このサイトを立ち上げました。
                    </p>
                    <p>
                        日本にはスタジオや商業施設向けの高い防音技術があります。一方で、マンションや戸建ての暮らしには、その知見が十分に届いていないと感じています。在宅ワーク、楽器練習、配信、近隣の生活音——悩みは多様ですが、共通しているのは「自分の環境に合う答えが見つけにくい」ということです。
                    </p>
                    <p>
                        防音Labでは、専門用語の整理だけでなく、あなたの状況から読み始められる記事を増やしていきます。少しでも役立つ一歩が見つかることを目指しています。
                    </p>
                </div>
            </aside>
        </section>

        <div class="back-link">
            <a href={`/${lang}/`}>
                <span class="arrow">←</span> {lang === 'ja' ? 'トップページへ' : 'Back to Home'}
            </a>
        </div>
    </main>
</StarlightPage>

<style>
    .page-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 10rem 2rem;
    }

    .page-header {
        margin-bottom: 6rem;
        text-align: center;
    }

    .eyebrow-box {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .line {
        width: 40px;
        height: 1px;
        background: var(--primary-gold);
        opacity: 0.5;
    }

    .eyebrow {
        font-size: 0.85rem;
        letter-spacing: 0.4rem;
        color: var(--primary-gold);
        font-weight: 500;
    }

    h1 {
        font-size: 3.5rem;
        margin-bottom: 2.5rem;
        line-height: 1.2;
        background: linear-gradient(to bottom, #fff, #aaa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .intro-text-large {
        font-size: 1.25rem;
        max-width: 700px;
        margin: 0 auto;
        line-height: 1.8;
        color: var(--text-light);
    }

    .mission-section {
        margin-bottom: 6rem;
        padding: 4rem;
        background: rgba(212, 175, 55, 0.03);
        border: 1px solid rgba(212, 175, 55, 0.1);
        border-radius: 20px;
        text-align: center;
    }

    .mission-section h2 {
        font-size: 2rem;
        margin-bottom: 2rem;
        color: var(--primary-gold);
    }

    .mission-section p {
        font-size: 1.15rem;
        line-height: 2;
        max-width: 800px;
        margin: 0 auto;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-bottom: 6rem;
    }

    .feature-card {
        padding: 2.5rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        transition: all 0.3s ease;
    }

    .feature-card:hover {
        background: rgba(212, 175, 55, 0.05);
        border-color: rgba(212, 175, 55, 0.2);
        transform: translateY(-5px);
    }

    .feature-card h3 {
        font-size: 1.4rem;
        margin-bottom: 1.5rem;
        color: var(--primary-gold);
    }

    .feature-card p {
        font-size: 0.95rem;
        line-height: 1.8;
        color: var(--text-dim);
    }

    .identity-card {
        padding: 3rem;
        background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(20, 20, 20, 0) 100%);
        border-left: 4px solid var(--primary-gold);
        border-radius: 0 12px 12px 0;
    }

    .author-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
        margin-bottom: 1.75rem;
    }

    .author-icon {
        width: 26px;
        height: 26px;
        color: var(--primary-gold);
        flex-shrink: 0;
    }

    .author-name {
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
        letter-spacing: 0.05em;
    }

    .author-links {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-left: 0.25rem;
    }

    .author-link {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.8rem;
        color: var(--text-dim);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .author-link:hover {
        color: var(--primary-gold);
    }

    .x-icon {
        width: 13px;
        height: 13px;
        flex-shrink: 0;
    }

    .author-sep {
        font-size: 0.8rem;
        color: var(--text-dim);
        opacity: 0.4;
    }

    .identity-card h4 {
        font-size: 1.25rem;
        margin-bottom: 1rem;
        color: #fff;
    }

    .identity-card p {
        font-size: 1rem;
        line-height: 1.8;
        color: var(--text-dim);
    }

    .back-link {
        margin-top: 10rem;
        text-align: center;
    }

    .back-link a {
        font-size: 1rem;
        font-weight: 500;
        color: var(--text-dim);
        text-decoration: none;
        letter-spacing: 0.1rem;
        transition: color 0.3s ease;
    }

    .back-link a:hover {
        color: var(--primary-gold);
    }

    .arrow {
        margin-right: 0.5rem;
    }

    @media (max-width: 768px) {
        .page-container { padding: 6rem 1.5rem; }
        h1 { font-size: 2.25rem; }
        .mission-section { padding: 2rem; }
        .feature-grid { grid-template-columns: 1fr; }
    }
</style>
