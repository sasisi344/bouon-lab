---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SmartLink from '../../../components/SmartLink.astro';
import RegionBanner from '../../../components/RegionBanner.astro';
import ArchiveCarousel from '../../../components/ArchiveCarousel.astro';
import AffiliateCard from '../../../components/AffiliateCard.astro';
import CtaBox from '../../../components/CtaBox.astro';
import AdUnit from '../../../components/AdUnit.astro';
import AssetValueTable from '../../../components/AssetValueTable.astro';
import { HUB_CLUSTERS } from '../../../data/hubClusters';
import { resolvePostCover } from '../../../data/categoryDefaultCover';
import { resolvePostSlugSegment } from '../../../utils/resolvePostSlugSegment';

export async function getStaticPaths() {
  const allContent = (await getCollection('posts'))
    .filter((post) => post.data.draft !== true);
  
  const resolveSlug = (post: (typeof allContent)[number]) =>
    resolvePostSlugSegment(post);

  const getRelatedScore = (
    basePost: (typeof allContent)[number],
    candidate: (typeof allContent)[number]
  ) => {
    const baseTags = new Set(basePost.data.tags || []);
    const candidateTags = candidate.data.tags || [];
    const tagMatchCount = candidateTags.filter(tag => baseTags.has(tag)).length;
    const categoryMatch = basePost.data.category === candidate.data.category ? 1 : 0;
    const dayDiff = Math.abs(basePost.data.date.valueOf() - candidate.data.date.valueOf()) / (1000 * 60 * 60 * 24);
    const recencyScore = Math.max(0, 365 - dayDiff) / 365;

    return (tagMatchCount * 10) + (categoryMatch * 5) + recencyScore;
  };

  return allContent.map(post => {
    const lang = post.data.lang || 'ja';
    const category = post.data.category;
    const slug = resolveSlug(post);
    const isIndex = slug === undefined;

    // 関連記事・アーカイブ記事を取得
    // 同一言語の全記事から抽出（コレクションを跨いでもOKにする）
    const langPosts = allContent
      .filter(p => 
        (p.data.lang || 'ja') === lang && 
        !p.id.endsWith('/index') &&
        p.id !== 'index'
      )
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    const categoryPosts = langPosts.filter(p => p.data.category === category);

    const relatedPosts = langPosts
      .filter(p => p.id !== post.id)
      .map(candidate => ({
        post: candidate,
        score: getRelatedScore(post, candidate),
      }))
      .sort((a, b) => {
        if (b.score !== a.score) return b.score - a.score;
        return b.post.data.date.valueOf() - a.post.data.date.valueOf();
      })
      .map(item => item.post)
      .slice(0, 12); // 最大12件

    return {
      params: { lang, category, slug },
      props: { post, relatedPosts, isIndex, allCategoryPosts: categoryPosts },
    };
  });
}

const { post, relatedPosts, isIndex, allCategoryPosts } = Astro.props;
const { Content, headings } = await render(post);

// パンくず等の情報を取得
const lang = post.data.lang || 'ja';
const category = post.data.category;
const locale = lang === 'ja' ? 'ja-JP' : 'en-US';

type NextStage = 'beginner' | 'compare' | 'action';
type StepLink = {
  stage: NextStage;
  title: string;
  url: string;
  reason: string;
};

function getUrl(post: any) {
    const lang = post.data.lang || 'ja';
    const segment = post.data.category;
    const slug = resolvePostSlugSegment(post);
    return slug ? `/${lang}/${segment}/${slug}/` : `/${lang}/${segment}/`;
}

const stageText: Record<NextStage, { ja: string; en: string }> = {
  beginner: { ja: '基礎を理解する', en: 'Build Basics' },
  compare: { ja: '選択肢を比較する', en: 'Compare Options' },
  action: { ja: '導入を進める', en: 'Take Action' },
};

const allLangPosts = relatedPosts;
const usedUrls = new Set<string>();

const pickFallbackPost = (stage: NextStage) => {
  const currentTags = new Set(post.data.tags || []);

  const scored = allLangPosts
    .map((candidate: any) => {
      const candidateUrl = getUrl(candidate);
      if (usedUrls.has(candidateUrl)) return null;

      const tagMatches = (candidate.data.tags || []).filter((tag: string) => currentTags.has(tag)).length;
      const categoryMatch = candidate.data.category === post.data.category ? 1 : 0;
      const solutionBoost =
        stage === 'action' &&
        [
          'soundproof-room',
          'soundproof-rental',
          'japan-soundproof-housing',
          'japan-quiet-spaces',
        ].includes(candidate.data.category)
          ? 2
          : 0;
      const compareBoost = stage === 'compare' && candidate.data.category === post.data.category ? 1 : 0;

      return {
        candidate,
        score: (tagMatches * 10) + (categoryMatch * 5) + (solutionBoost * 5) + (compareBoost * 3),
      };
    })
    .filter(Boolean)
    .sort((a: any, b: any) => {
      if (b.score !== a.score) return b.score - a.score;
      return b.candidate.data.date.valueOf() - a.candidate.data.date.valueOf();
    });

  return scored[0]?.candidate;
};

const hubMatch = HUB_CLUSTERS.find((cluster) => {
  const haystack = `${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`.toLowerCase();
  return cluster.matchKeywords.some((keyword) => haystack.includes(keyword.toLowerCase()));
});

const manualSteps = (post.data.nextSteps || []).reduce((acc: Record<string, any>, step) => {
  acc[step.stage] = step;
  return acc;
}, {});

const nextSteps: StepLink[] = (['beginner', 'compare', 'action'] as NextStage[]).map((stage) => {
  const manual = manualSteps[stage];
  if (manual?.url) {
    usedUrls.add(manual.url);
    return {
      stage,
      title: manual.title || stageText[stage][lang === 'ja' ? 'ja' : 'en'],
      url: manual.url,
      reason: lang === 'ja' ? '手動設定' : 'Manual path',
    };
  }

  if (manual?.slug) {
    const manualPost = allLangPosts.find((candidate: any) => {
      const seg = resolvePostSlugSegment(candidate);
      if (seg === manual.slug) return true;
      const short = candidate.data.slug?.trim();
      if (short && short === manual.slug) return true;
      return candidate.id.endsWith(`/${manual.slug}`);
    });
    if (manualPost) {
      const manualUrl = getUrl(manualPost);
      usedUrls.add(manualUrl);
      return {
        stage,
        title: manual.title || manualPost.data.title,
        url: manualUrl,
        reason: lang === 'ja' ? '手動指定' : 'Manual slug',
      };
    }
  }

  const fallbackPost = pickFallbackPost(stage);
  if (fallbackPost) {
    const fallbackUrl = getUrl(fallbackPost);
    usedUrls.add(fallbackUrl);
    return {
      stage,
      title: fallbackPost.data.title,
      url: fallbackUrl,
      reason: stage === 'beginner'
        ? (lang === 'ja' ? '同タグ優先' : 'Tag match')
        : stage === 'compare'
          ? (lang === 'ja' ? '同カテゴリ優先' : 'Category match')
          : (lang === 'ja' ? '導入記事を優先' : 'Action-oriented'),
    };
  }

  const fallbackUrl = hubMatch ? `/${lang}/${hubMatch.categoryHint}/` : `/${lang}/${post.data.category}/`;
  return {
    stage,
    title: hubMatch ? hubMatch.labels[lang === 'ja' ? 'ja' : 'en'].title : stageText[stage][lang === 'ja' ? 'ja' : 'en'],
    url: fallbackUrl,
    reason: lang === 'ja' ? 'ハブ入口へフォールバック' : 'Hub fallback',
  };
});

const nextStepUrls = new Set(nextSteps.map((step) => step.url));
const dedupedRelatedPosts = relatedPosts.filter((candidate: any) => !nextStepUrls.has(getUrl(candidate)));
const relatedPostsWithLabels = dedupedRelatedPosts.map((candidate: any) => {
  const currentTags = new Set(post.data.tags || []);
  const tagMatches = (candidate.data.tags || []).filter((tag: string) => currentTags.has(tag)).length;
  const categoryMatch = candidate.data.category === post.data.category;

  if (tagMatches > 0) {
    return {
      post: candidate,
      relationLabel: lang === 'ja' ? `同タグ ${tagMatches}` : `${tagMatches} shared tags`,
      relationKey: 'tag',
    };
  }

  if (categoryMatch) {
    return {
      post: candidate,
      relationLabel: lang === 'ja' ? '同カテゴリ' : 'Same category',
      relationKey: 'category',
    };
  }

  return {
    post: candidate,
    relationLabel: lang === 'ja' ? '近い更新時期' : 'Recent update',
    relationKey: 'recency',
  };
});

const manualStarterSlugs: string[] = post.data.starterSet || [];
const manualStarterPosts = manualStarterSlugs
  .map((slug: string) =>
    allCategoryPosts.find((candidate: any) => {
      const seg = resolvePostSlugSegment(candidate);
      if (seg === slug) return true;
      const short = candidate.data.slug?.trim();
      if (short && short === slug) return true;
      return candidate.id.endsWith(`/${slug}`);
    })
  )
  .filter(Boolean);

const starterSelectedUrls = new Set(manualStarterPosts.map((item: any) => getUrl(item)));
const starterAutoPosts = allCategoryPosts
  .filter((candidate: any) => !starterSelectedUrls.has(getUrl(candidate)))
  .map((candidate: any) => {
    const indexTags = new Set(post.data.tags || []);
    const tagMatches = (candidate.data.tags || []).filter((tag: string) => indexTags.has(tag)).length;
    const recencyBoost = Math.max(0, 365 - (Date.now() - candidate.data.date.valueOf()) / (1000 * 60 * 60 * 24));
    return {
      candidate,
      score: tagMatches * 10 + recencyBoost,
    };
  })
  .sort((a: any, b: any) => b.score - a.score)
  .map((item: any) => item.candidate);

const starterSetPosts = [...manualStarterPosts, ...starterAutoPosts].slice(0, 6);

const getRecommendedReadMinutes = (entry: any) => {
  const raw = entry.body ?? '';
  const body = raw
    .replace(/```[\s\S]*?```/g, '')
    .replace(/`[^`]*`/g, '')
    .replace(/<[^>]+\/?>/g, '')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_~|]/g, '')
    .replace(/^[-*+>]\s+/gm, '')
    .replace(/^\d+\.\s+/gm, '')
    .trim();
  const total = `${entry.data.title} ${entry.data.description} ${body}`;
  const charsPerMinute = lang === 'ja' ? 500 : 1000;
  return Math.max(1, Math.round(total.length / charsPerMinute));
};

const components = {
    SmartLink,
    RegionBanner,
    ArchiveCarousel,
    AffiliateCard,
    CtaBox,
    AssetValueTable
};

// JSON-LD・og:image 用データ
const siteUrl = 'https://bouon-lab.com';
const canonicalUrl = `${siteUrl}${getUrl(post)}`;
const optimizedCover = await getImage({ src: resolvePostCover(post), width: 1200, height: 675, format: 'webp' });
const ogImageUrl = `${siteUrl}${optimizedCover.src}`;

const breadcrumbList = isIndex
  ? [
      { name: 'HOME', item: `${siteUrl}/${lang}/` },
      { name: category.toUpperCase(), item: canonicalUrl },
    ]
  : [
      { name: 'HOME', item: `${siteUrl}/${lang}/` },
      { name: category.toUpperCase(), item: `${siteUrl}/${lang}/${category}/` },
      { name: post.data.title, item: canonicalUrl },
    ];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbList.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: entry.name,
    item: entry.item,
  })),
};

const articleJsonLd = !isIndex ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: ogImageUrl,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.lastmod ?? post.data.date).toISOString(),
  inLanguage: lang,
  author: { '@type': 'Organization', name: '防音Lab', url: siteUrl },
  publisher: {
    '@type': 'Organization',
    name: '防音Lab',
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
} : null;

const pageHead = [
  { tag: 'meta', attrs: { property: 'og:image', content: ogImageUrl } },
  { tag: 'meta', attrs: { property: 'og:image:width', content: '1200' } },
  { tag: 'meta', attrs: { property: 'og:image:height', content: '675' } },
  { tag: 'meta', attrs: { name: 'twitter:image', content: ogImageUrl } },
  {
    tag: 'script',
    attrs: { type: 'application/ld+json' },
    content: JSON.stringify(breadcrumbJsonLd),
  },
  ...(articleJsonLd
    ? [{ tag: 'script', attrs: { type: 'application/ld+json' }, content: JSON.stringify(articleJsonLd) }]
    : []),
];
---

<StarlightPage
  frontmatter={{
    title: post.data.title,
    description: post.data.description,
    head: pageHead,
  }}
  headings={headings}
  hasSidebar={true}
>
  <div class="article-wrapper">
    <!-- 知的なパンくずリスト -->
    <nav class="breadcrumb">
      <a href={`/${lang}/`}>HOME</a>
      <span class="sep">/</span>
      {isIndex ? (
        <span class="current">{category.toUpperCase()}</span>
      ) : (
        <>
          <a href={`/${lang}/${category}/`}>{category.toUpperCase()}</a>
          <span class="sep">/</span>
          <span class="current">{post.data.subcategory || 'RESEARCH'}</span>
        </>
      )}
    </nav>

    <article class="article-content">
      <header class="article-header">
        <div class="meta-top">
           <span class="date">{post.data.date.toLocaleDateString(lang === 'ja' ? 'ja-JP' : 'en-US')}</span>
           <span class="lang-tag">{lang.toUpperCase()}</span>
        </div>
        <h1 id="_top">{post.data.title}</h1>
        <p class="description">{post.data.description}</p>
        <div class="featured-image-container">
          <Image src={resolvePostCover(post)} alt={post.data.title} class="featured-image" width={1200} height={675} format="webp" />
        </div>
      </header>

      <div class="region-notif">
        <RegionBanner />
      </div>

      <div class="prose-body">
        <Content components={components} relatedPosts={relatedPosts} lang={lang} />
      </div>

      {isIndex && (
        <section class="category-posts-list">
          <div class="starter-set">
            <div class="section-divider">
              <span class="divider-text">{lang === 'ja' ? '初めての人向けスターターセット' : 'Starter Set for Beginners'}</span>
            </div>
            <div class="starter-grid">
              {starterSetPosts.map((item: any, index: number) => (
                <article class="starter-card">
                  <span class="starter-rank">#{index + 1}</span>
                  <h3><a href={getUrl(item)}>{item.data.title}</a></h3>
                  <p>{item.data.description}</p>
                  <div class="starter-meta">
                    <span>{item.data.date.toLocaleDateString(locale)}</span>
                    <span>{lang === 'ja' ? `読了 ${getRecommendedReadMinutes(item)}分` : `${getRecommendedReadMinutes(item)} min read`}</span>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="section-divider">
            <span class="divider-text">{lang === 'ja' ? '研究成果一覧' : 'All Research'}</span>
          </div>
          <div class="posts-grid" id="posts-grid">
            {allCategoryPosts.map((item, index) => (
              <article class="post-card" data-index={index} style={index >= 6 ? "display: none;" : ""}>
                <div class="card-image-box">
                  <Image src={resolvePostCover(item)} alt={item.data.title} class="card-img" width={600} height={338} format="webp" />
                </div>
                <div class="card-content">
                  <div class="card-meta">
                    <span class="date">{item.data.date.toLocaleDateString(locale)}</span>
                    <span class="reading-time">{lang === 'ja' ? `読了 ${getRecommendedReadMinutes(item)}分` : `${getRecommendedReadMinutes(item)} min read`}</span>
                  </div>
                  <h3 class="post-title">
                    <a href={getUrl(item)} class="link-text">
                      {item.data.title}
                    </a>
                  </h3>
                  <p>{item.data.description}</p>
                  <div class="card-footer">
                    <a href={getUrl(item)} class="read-more">
                      READ MORE →
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
          
          {allCategoryPosts.length > 6 && (
            <div class="load-more-container">
              <button id="load-more-btn" class="btn-load-more">
                {lang === 'ja' ? 'さらに記事を読み込む' : 'Load More Articles'}
                <span class="count-info">
                  (<span id="current-count">6</span> / {allCategoryPosts.length})
                </span>
              </button>
            </div>
          )}
        </section>
      )}

      <script is:inline>
        function initLoadMore() {
          const btn = document.getElementById('load-more-btn');
          const grid = document.getElementById('posts-grid');
          if (!btn || !grid) return;

          let currentVisible = 6;
          const increment = 6;
          const allCards = grid.querySelectorAll('.post-card');
          const total = allCards.length;
          const countDisplay = document.getElementById('current-count');

          btn.addEventListener('click', () => {
            const nextCount = currentVisible + increment;
            
            allCards.forEach((card, index) => {
              if (index < nextCount) {
                card.style.display = 'flex';
                // フェードイン効果
                card.style.animation = 'fadeIn 0.5s ease forwards';
              }
            });

            currentVisible = nextCount;
            if (countDisplay) countDisplay.textContent = Math.min(currentVisible, total);

            if (currentVisible >= total) {
              btn.style.display = 'none';
            }
          });
        }

        // 初期化
        initLoadMore();
        // View Transitions対応
        document.addEventListener('astro:after-swap', initLoadMore);
      </script>

      {!isIndex && (
        <footer class="article-footer">
            <AdUnit placement="rectangleArticleEnd" />

            <div class="tag-label">KEYWORDS</div>
            <div class="tag-cloud">
                {post.data.tags.map(tag => (
                    <span class="tag-item">#{tag}</span>
                ))}
            </div>

            {nextSteps.length > 0 && (
              <section class="next-step-section">
                <div class="section-divider">
                  <span class="divider-text">{lang === 'ja' ? '次に読む（Next Step）' : 'Next Step'}</span>
                </div>
                <div class="next-step-grid">
                  {nextSteps.map((step) => (
                    <a
                      href={step.url}
                      class="next-step-card"
                      data-track-event="next_step_click"
                      data-track-source={`next_step_${step.stage}`}
                      data-track-label={step.title}
                    >
                      <div class="stage">{stageText[step.stage][lang === 'ja' ? 'ja' : 'en']}</div>
                      <h3>{step.title}</h3>
                      <p>{step.reason}</p>
                    </a>
                  ))}
                </div>
              </section>
            )}

            {relatedPostsWithLabels && relatedPostsWithLabels.length > 0 && (
              <section class="related-articles-section">
                <div class="section-divider">
                  <span class="divider-text">{lang === 'ja' ? 'こちらの研究成果もおすすめ' : 'Recommended Research'}</span>
                </div>
                <ArchiveCarousel
                  relatedPosts={relatedPostsWithLabels}
                  lang={lang}
                  limitByDevice={true}
                  trackEvent="related_click"
                  trackSource="related_section"
                />
              </section>
            )}
        </footer>
      )}
    </article>
  </div>
</StarlightPage>

<style>
  .article-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem 8rem;
  }

  .breadcrumb {
    font-size: 0.75rem;
    letter-spacing: 0.1rem;
    margin-bottom: 3rem;
    color: var(--text-dim);
    text-align: center;
  }
  .breadcrumb a {
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.3s;
  }
  .breadcrumb a:hover { color: var(--primary-gold); }
  .breadcrumb .sep { margin: 0 0.5rem; opacity: 0.3; }
  .breadcrumb .current { color: var(--primary-gold); font-weight: bold; }

  .article-content {
    background: var(--bg-mocha);
    padding: 4rem;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.03);
    box-shadow: 0 30px 60px rgba(0,0,0,0.4);
  }

  .article-header {
    margin-bottom: 4rem;
    text-align: center;
  }

  .meta-top {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.2rem;
    color: var(--text-dim);
  }

  .lang-tag {
    border: 1px solid var(--primary-gold);
    color: var(--primary-gold);
    padding: 0 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
  }

  h1 {
    font-family: var(--font-ud-mincho);
    font-size: 3rem;
    color: #fff;
    line-height: 1.2;
    margin-bottom: 2rem;
    text-shadow: 0 0 20px rgba(212, 175, 55, 0.1);
  }

  .description {
    font-family: var(--font-ud-gothic);
    font-size: 1.2rem;
    color: var(--text-dim);
    line-height: 1.8;
    max-width: 700px;
    margin: 0 auto;
    letter-spacing: 0.05rem;
  }

  .featured-image-container {
    margin-top: 3rem;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
  }
  .featured-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .region-notif {
    margin: 2rem 0 4rem;
  }

  /* 文章本体のスタイリング */
  .prose-body {
    color: var(--text-light);
    font-size: 1.125rem;
    line-height: 1.9;
    letter-spacing: 0.03em;
  }

  .prose-body :global(p) {
    font-family: var(--font-body-text);
    font-weight: 400; /* Regular */
    margin-bottom: 2rem;
  }

  .prose-body :global(h2) {
    font-family: var(--font-ud-mincho);
    font-size: 2rem;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    padding-bottom: 0.5rem;
    margin-top: 4rem;
    margin-bottom: 2rem;
  }

  .prose-body :global(strong) {
    color: #fff;
    box-shadow: inset 0 -0.5em 0 rgba(212, 175, 55, 0.1);
  }

  /* 記事内画像の共通制御：デフォルトはコンテンツ幅に収める */
  .prose-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 2rem auto;
    display: block;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  /* インフォグラフィック等、あえて広く見せたい画像用のクラス */
  .prose-body :global(img.wide) {
    max-width: none;
    width: 100%;
  }

  /* アーカイブ（記事一覧）セクション */
  .archive-section {
    margin-top: 8rem;
    padding-top: 4rem;
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .section-divider {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2rem;
  }

