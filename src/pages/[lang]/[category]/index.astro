---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
  JA_TOP_CATEGORIES,
  TOP_CATEGORY_LABELS,
} from '../../../data/contentCategories';
import { resolvePostCover } from '../../../data/categoryDefaultCover';
import { resolvePostSlugSegment } from '../../../utils/resolvePostSlugSegment';

const CATEGORY_LABELS = TOP_CATEGORY_LABELS;

export async function getStaticPaths() {
  const paths: { params: { lang: string; category: string } }[] = [];
  for (const category of JA_TOP_CATEGORIES) {
    paths.push({ params: { lang: 'ja', category } });
  }
  return paths;
}

const { lang: paramLang, category: paramCategory } = Astro.params;
const lang = paramLang === 'en' ? 'en' : 'ja';
const category = paramCategory || '';
const locale = lang === 'ja' ? 'ja-JP' : 'en-US';

const allContent = (await getCollection('posts')).filter((p) => p.data.draft !== true);

const label =
  CATEGORY_LABELS[category as keyof typeof CATEGORY_LABELS]?.[
    lang === 'ja' ? 'ja' : 'en'
  ] ?? category;
const pageTitle =
  lang === 'ja' ? `${label}｜記事一覧` : `${label} | Articles`;
const pageDescription =
  lang === 'ja'
    ? `「${label}」カテゴリの防音Lab記事一覧です。`
    : `Browse BouonLab articles in the ${label} category.`;

function resolveSlug(post: (typeof allContent)[number]) {
  return resolvePostSlugSegment(post) ?? '';
}

function getUrl(post: (typeof allContent)[number]) {
  const postLang = post.data.lang || 'ja';
  const segment = post.data.category;
  const slug = resolvePostSlugSegment(post);
  return slug ? `/${postLang}/${segment}/${slug}/` : `/${postLang}/${segment}/`;
}

const getRecommendedReadMinutes = (entry: (typeof allContent)[number]) => {
  const raw = (entry as any).body ?? '';
  const body = raw
    .replace(/```[\s\S]*?```/g, '')          // コードブロック除去
    .replace(/`[^`]*`/g, '')                 // インラインコード除去
    .replace(/<[^>]+\/?>/g, '')              // HTMLタグ・MDXコンポーネント除去
    .replace(/^#{1,6}\s+/gm, '')             // 見出し記号除去
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // リンク → テキストのみ
    .replace(/[*_~|]/g, '')                  // 装飾記号除去
    .replace(/^[-*+>]\s+/gm, '')             // リスト・引用記号除去
    .replace(/^\d+\.\s+/gm, '')              // 番号リスト除去
    .trim();
  const total = `${entry.data.title} ${entry.data.description} ${body}`;
  const charsPerMinute = lang === 'ja' ? 500 : 1000;
  return Math.max(1, Math.round(total.length / charsPerMinute));
};

const categoryPosts = allContent
  .filter((p) => (p.data.lang || 'ja') === lang && p.data.category === category)
  .filter((p) => resolveSlug(p) !== '')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const starterSetPosts = categoryPosts.slice(0, 6);
---

<StarlightPage frontmatter={{ title: pageTitle, description: pageDescription, tableOfContents: false }} hasSidebar={true}>
  <div class="article-wrapper">
    <nav class="breadcrumb">
      <a href={`/${lang}/`}>HOME</a>
      <span class="sep">/</span>
      <span class="current">{label}</span>
    </nav>

    <article class="article-content">
      <header class="article-header">
        <div class="meta-top">
          <span class="lang-tag">{lang.toUpperCase()}</span>
        </div>
        <h1 id="_top">{label}</h1>
        <p class="description">{pageDescription}</p>
      </header>

      <section class="category-posts-list">

        {/* ── 注目の記事：2カラム・タイトルのみ ── */}
        {starterSetPosts.length > 0 && (
          <div class="starter-set">
            <div class="section-divider">
              <span class="divider-text">
                {lang === 'ja' ? '注目の記事' : 'Featured'}
              </span>
            </div>
            <div class="starter-grid">
              {starterSetPosts.map((item, index) => (
                <a href={getUrl(item)} class="starter-card">
                  <span class="starter-rank">0{index + 1}</span>
                  <span class="starter-title">{item.data.title}</span>
                  <span class="starter-date">
                    {item.data.date.toLocaleDateString(locale)}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}

        {/* ── 記事一覧：1カラムリスト ── */}
        <div class="section-divider">
          <span class="divider-text">
            {lang === 'ja' ? '記事一覧' : 'All articles'}
          </span>
        </div>
        {categoryPosts.length === 0 && (
          <p class="empty-hint">
            {lang === 'ja'
              ? 'このカテゴリの記事はまだありません。'
              : 'No articles in this category yet.'}
          </p>
        )}
        <ul class="posts-list" id="posts-grid">
          {categoryPosts.map((item, index) => (
            <li
              class="post-list-item"
              data-index={index}
              style={index >= 12 ? 'display: none;' : ''}
            >
              <a href={getUrl(item)} class="post-list-link">
                <span class="post-list-title">{item.data.title}</span>
                <span class="post-list-meta">
                  <span class="post-list-date">
                    {item.data.date.toLocaleDateString(locale)}
                  </span>
                  <span class="post-list-readtime">
                    {lang === 'ja'
                      ? `${getRecommendedReadMinutes(item)}分`
                      : `${getRecommendedReadMinutes(item)} min`}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        {categoryPosts.length > 12 && (
          <div class="load-more-container">
            <button id="load-more-btn" class="btn-load-more" type="button">
              {lang === 'ja' ? 'さらに読み込む' : 'Load More'}
              <span class="count-info">
                (<span id="current-count">12</span> / {categoryPosts.length})
              </span>
            </button>
          </div>
        )}
      </section>
    </article>
  </div>
</StarlightPage>

<script is:inline>
  function initLoadMore() {
    const btn = document.getElementById('load-more-btn');
    const grid = document.getElementById('posts-grid');
    if (!btn || !grid) return;

    let currentVisible = 12;
    const increment = 12;
    const allCards = grid.querySelectorAll('.post-list-item');
    const total = allCards.length;
    const countDisplay = document.getElementById('current-count');

    btn.addEventListener('click', () => {
      const nextCount = currentVisible + increment;

      allCards.forEach((card, index) => {
        if (index < nextCount) {
          card.style.display = 'block';
          card.style.animation = 'fadeIn 0.3s ease forwards';
        }
      });

      currentVisible = nextCount;
      if (countDisplay) countDisplay.textContent = String(Math.min(currentVisible, total));

      if (currentVisible >= total) {
        btn.style.display = 'none';
      }
    });
  }

  initLoadMore();
  document.addEventListener('astro:after-swap', initLoadMore);
</script>

<style>
  /* ── ラッパー・ヘッダー ── */
  .article-wrapper {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem 1rem 6rem;
  }

  .breadcrumb {
    font-size: 0.75rem;
    letter-spacing: 0.08rem;
    margin-bottom: 2rem;
    color: var(--sl-color-gray-3);
  }
  .breadcrumb a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .breadcrumb a:hover { color: var(--sl-color-accent); }
  .breadcrumb .sep { margin: 0 0.4rem; opacity: 0.4; }
  .breadcrumb .current { color: var(--sl-color-accent); font-weight: 600; }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .meta-top {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.1rem;
    color: var(--sl-color-gray-3);
  }

  .lang-tag {
    border: 1px solid var(--sl-color-accent);
    color: var(--sl-color-accent);
    padding: 0.1em 0.4em;
    border-radius: 3px;
    font-size: 0.65rem;
  }

  h1 {
    font-size: 2rem;
    margin: 0 0 0.6rem;
    line-height: 1.3;
    color: var(--sl-color-white);
  }

  .description {
    font-size: 0.95rem;
    color: var(--sl-color-gray-3);
    line-height: 1.7;
  }

  /* ── セクション区切り ── */
  .section-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }
  .divider-text {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15rem;
    color: var(--sl-color-accent);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .section-divider::after {
    content: '';
    flex-grow: 1;
    height: 1px;
    background: var(--sl-color-hairline);
  }

  .category-posts-list { margin-top: 2rem; }

  .empty-hint {
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
    margin: 1.5rem 0;
  }

  /* ══════════════════════════════════════
     注目の記事 — 2カラム・タイトルのみ
  ══════════════════════════════════════ */
  .starter-set { margin-bottom: 3rem; }

  .starter-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
  }

  .starter-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
    background: transparent;
  }
  .starter-card:hover {
    border-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 4%, transparent);
  }

  .starter-rank {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08rem;
    color: var(--sl-color-accent);
  }

  .starter-title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--sl-color-white);
  }

  .starter-date {
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.1rem;
  }

  /* ══════════════════════════════════════
     記事一覧 — 1カラムリスト
  ══════════════════════════════════════ */
  .posts-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list-item {
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }
  .post-list-item:first-child {
    border-top: 1px solid var(--sl-color-hairline-light);
  }

  .post-list-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0.5rem;
    text-decoration: none;
    transition: background 0.15s;
    border-radius: 4px;
  }
  .post-list-link:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 4%, transparent);
  }
  .post-list-link:hover .post-list-title {
    color: var(--sl-color-accent);
  }

  .post-list-title {
    font-size: 0.925rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--sl-color-text);
    flex: 1;
    transition: color 0.15s;
  }

  .post-list-meta {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .post-list-date {
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
  }

  .post-list-readtime {
    font-size: 0.7rem;
    color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
    padding: 0.1em 0.45em;
    border-radius: 3px;
  }

  /* ── もっと読む ── */
  .load-more-container {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .btn-load-more {
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-text);
    padding: 0.7rem 2rem;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-load-more:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  .count-info {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── レスポンシブ ── */
  @media (max-width: 600px) {
    .starter-grid { grid-template-columns: 1fr; }
    .post-list-meta { display: none; }
    h1 { font-size: 1.6rem; }
  }
</style>
