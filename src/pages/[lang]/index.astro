---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import heroImage from '../../assets/images/hero-mocha.png';
import { HUB_CLUSTERS } from '../../data/hubClusters';
import {
  topCategoriesForLang,
  labelForCategory,
} from '../../data/contentCategories';
import { resolvePostCover } from '../../data/categoryDefaultCover';
import { resolvePostSlugSegment } from '../../utils/resolvePostSlugSegment';
import AdUnit from '../../components/AdUnit.astro';

export async function getStaticPaths() {
    return [
        { params: { lang: 'ja' } },
    ];
}

const { lang } = Astro.params;
const uiLang: 'ja' | 'en' = lang === 'en' ? 'en' : 'ja';

const allContent = (await getCollection('posts'))
  .filter((post) => post.data.draft !== true);
const filteredPosts = allContent.filter(p => p.data.lang === lang);

/** トップ「最新」一覧：最大50件・初期表示6件・もっと見るで6件ずつ追加（クライアント側スクリプトと同期） */
const MAX_HOME_LATEST = 50;
const HOME_INITIAL_VISIBLE = 6;

const sortedByDate = filteredPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestPostsForHome = sortedByDate.slice(0, MAX_HOME_LATEST);

function getSlug(post: any) {
    return resolvePostSlugSegment(post) ?? '';
}

function getUrl(post: any) {
    const slug = getSlug(post);
    const category = post.data.category;
    const lang = post.data.lang || 'ja';
    return slug ? `/${lang}/${category}/${slug}/` : `/${lang}/${category}/`;
}

const HUB_POSTS_COUNT = 3;

const hubRoutes = HUB_CLUSTERS.map((cluster) => {
  const pool = filteredPosts.filter((post) => {
    const text = `${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`.toLowerCase();
    return cluster.matchKeywords.some((keyword) => text.includes(keyword.toLowerCase()));
  });

  const sortedPool = pool.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const categoryFallback =
    lang === 'en' && cluster.categoryHintEn
      ? cluster.categoryHintEn
      : cluster.categoryHint;
  const fallbackPool = filteredPosts
    .filter((post) => post.data.category === categoryFallback)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  const matchedIds = new Set(sortedPool.map((post) => post.id));
  const mergedPool = [
    ...sortedPool,
    ...fallbackPool.filter((post) => !matchedIds.has(post.id)),
  ];
  const featuredPosts = mergedPool.slice(0, HUB_POSTS_COUNT);

  return {
    ...cluster,
    featuredPosts,
    count: sortedPool.length || fallbackPool.length,
    categoryUrl: `/${lang}/${categoryFallback}/`,
  };
}).filter((route) => route.featuredPosts.length > 0);

// ヒーロー画像の最適化
const optimizedHero = await getImage({ src: heroImage, format: 'webp' });

const directoryCategories = topCategoriesForLang(uiLang);
---

<StarlightPage frontmatter={{
  title: lang === 'ja' ? '防音の悩みを症状別に解決｜賃貸・防音室・DIY対策ガイド' : 'Soundproofing that fits your space | BouonLab',
  description: lang === 'ja'
    ? '「うるさい」「音漏れが心配」「防音室を選びたい」——あなたの状況別に最適な対策が見つかります。賃貸の防音問題から防音室選び、DIY対策まで実例とデータで解説します。'
    : 'Find soundproofing solutions that fit your home, budget, and how you live in Japan.',
  template: 'splash',
}} hasSidebar={false}>
  <!-- ダーク・モカ・ヒーローセクション -->
  <section class="hero-dark" style={`background-image: url('${optimizedHero.src}')`}>
    <div class="overlay"></div>
    <div class="hero-content">
      <div class="eyebrow-box">
        <div class="line"></div>
        <span class="eyebrow">{lang === 'ja' ? 'YOUR QUIET SPACE' : 'YOUR QUIET SPACE'}</span>
      </div>
      <h1>{lang === 'ja' ? 'あなたの環境に、合わせた防音を。' : 'Soundproofing that fits your space.'}</h1>
      <p class="lead">
        {lang === 'ja' 
          ? '防音Labは、住まい・予算・用途の違いに寄り添い、あなたに合う防音の解決策をまとめたガイドです。' 
          : 'BouonLab helps you find soundproofing options that fit your home, budget, and how you live.'}
      </p>

      <!-- 二分するナビゲーション -->
      <div class="action-branch">
        <a href="#knowledge" class="btn primary">
          <span class="icon">📖</span>
          <span class="text">
            <strong>{lang === 'ja' ? '記事から探す' : 'Browse articles'}</strong>
            <small>{lang === 'ja' ? 'あなたの状況に近い記事から読み始める' : 'Start with articles close to your situation'}</small>
          </span>
        </a>
        <a
          href={
            lang === 'ja'
              ? `/${lang}/soundproof-room/`
              : `/${lang}/japan-quiet-spaces/`
          }
          class="btn secondary"
        >
          <span class="icon">🔍</span>
          <span class="text">
            <strong>
              {lang === 'ja'
                ? '課題から探す'
                : 'Japan: Rooms & Creators'}
            </strong>
            <small>
              {lang === 'ja'
                ? '防音室・賃貸・配信など用途別に絞り込む'
                : 'How booths and quiet spaces work here'}
            </small>
          </span>
        </a>
      </div>
    </div>
  </section>

  <main class="container" id="knowledge">
    <AdUnit placement="rectangleList" class="ad-placement--page-top" />

    <!-- 最新記事（先頭表示・最大50件・もっと見る） -->
    <section class="section section--latest">
      <div class="section-header">
        <h2 class="section-title">{lang === 'ja' ? '最新記事' : 'Latest Articles'}</h2>
        <p class="section-desc">{lang === 'ja' ? '日々更新される防音の実践ナレッジ' : 'Practical soundproofing articles, updated regularly'}</p>
      </div>

      <div class="posts-grid posts-grid--latest" id="latest-posts-grid">
        {latestPostsForHome.map((post, index) => (
          <article
            class="post-card"
            data-index={index}
            style={index >= HOME_INITIAL_VISIBLE ? 'display: none;' : ''}
          >
            <div class="card-image-box">
              <Image src={resolvePostCover(post)} alt={post.data.title} class="card-img" width={600} height={338} format="webp" />
            </div>
            <div class="card-content">
              <div class="card-meta">
                <span class="category">{labelForCategory(post.data.category, uiLang)}</span>
                <span class="date">{post.data.date.toLocaleDateString(lang === 'ja' ? 'ja-JP' : 'en-US')}</span>
              </div>
              <h3 class="post-title">
                <a href={getUrl(post)} class="link-text">
                  {post.data.title}
                </a>
              </h3>
              <p>{post.data.description}</p>
              <div class="card-footer">
                <a href={getUrl(post)} class="read-more">
                  READ MORE →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      {latestPostsForHome.length > HOME_INITIAL_VISIBLE && (
        <div class="load-more-container">
          <button id="latest-load-more-btn" class="btn-load-more" type="button">
            {lang === 'ja' ? 'もっと見る' : 'Show more'}
            <span class="count-info">
              (<span id="latest-current-count">{HOME_INITIAL_VISIBLE}</span> / {latestPostsForHome.length})
            </span>
          </button>
        </div>
      )}
    </section>

    <section class="section">
      <div class="section-header">
        <h2 class="section-title">{lang === 'ja' ? '課題別ハブから読み進める' : 'Start from Persona Hubs'}</h2>
        <p class="section-desc">{lang === 'ja' ? '対象ユーザーと悩みから、最初に読むべき記事へ案内します。' : 'Pick your user context and jump to the best first article.'}</p>
      </div>
      <div class="hub-grid">
        {hubRoutes.map((hub) => (
          <article class="hub-card">
            <div class="hub-label">{hub.labels[lang as 'ja' | 'en'].audience}</div>
            <h3>{hub.labels[lang as 'ja' | 'en'].title}</h3>
            <p>{hub.labels[lang as 'ja' | 'en'].pain}</p>
            <ul class="hub-entries">
              {hub.featuredPosts.map((post) => (
                <li>
                  <a
                    href={getUrl(post)}
                    data-track-event="hub_click"
                    data-track-source="hub_entry"
                    data-track-label={post.data.title}
                  >
                    {post.data.title}
                  </a>
                </li>
              ))}
            </ul>
            <div class="hub-footer">
              <a
                href={hub.categoryUrl}
                class="hub-link"
                data-track-event="hub_click"
                data-track-source="hub_cta"
                data-track-label={hub.labels[lang as 'ja' | 'en'].title}
              >
                {hub.labels[lang as 'ja' | 'en'].primaryCta}
              </a>
              <span class="hub-count">{lang === 'ja' ? `${hub.count}件` : `${hub.count} posts`}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- カテゴリ・ナビゲーション -->
    <section class="section">
      <h2 class="section-title centered">{lang === 'ja' ? 'ナレッジ・ディレクトリ' : 'Knowledge Directory'}</h2>
      <div class="category-pills">
        {directoryCategories.map((cat) => (
          <a href={`/${lang}/${cat}/`} class="pill">
            <span class="pill-name">{labelForCategory(cat, uiLang)}</span>
            <span class="pill-count">{filteredPosts.filter(p => p.data.category === cat).length}</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <script is:inline>
    function initLatestLoadMore() {
      const btn = document.getElementById('latest-load-more-btn');
      const grid = document.getElementById('latest-posts-grid');
      if (!btn || !grid) return;

      let currentVisible = 6;
      const increment = 6;
      const allCards = grid.querySelectorAll('.post-card');
      const total = allCards.length;
      const countDisplay = document.getElementById('latest-current-count');

      btn.addEventListener('click', () => {
        const nextCount = Math.min(currentVisible + increment, total);

        allCards.forEach((card, index) => {
          if (index < nextCount) {
            card.style.display = 'flex';
            card.style.animation = 'fadeIn 0.5s ease forwards';
          }
        });

        currentVisible = nextCount;
        if (countDisplay) countDisplay.textContent = String(currentVisible);

        if (currentVisible >= total) {
          btn.style.display = 'none';
        }
      });
    }

    initLatestLoadMore();
    document.addEventListener('astro:after-swap', initLatestLoadMore);
  </script>
</StarlightPage>

<style>
  /* ヒーロー：暗室と光の演出 */
  .hero-dark {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #0D0B0A;
    background-size: cover;
    background-position: center;
    overflow: hidden;
    padding: 2rem;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at center, rgba(26, 22, 20, 0.4) 0%, rgba(13, 11, 10, 0.95) 80%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    text-align: center;
  }

  .eyebrow-box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .line {
    width: 40px;
    height: 1px;
    background: var(--primary-gold);
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.4rem;
    color: var(--primary-gold);
  }

  h1 {
    font-family: var(--font-ud-mincho);
    font-size: 4.5rem;
    color: #fff;
    margin: 0;
    line-height: 1.1;
    text-shadow: 0 0 30px rgba(212, 175, 55, 0.2);
  }

  .lead {
    font-size: 1.2rem;
    color: var(--text-dim);
    margin: 2rem auto 4rem;
    max-width: 600px;
  }

  /* 分岐ナビゲーション */
  .action-branch {
    display: flex;
    gap: 2rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem 2.5rem;
    border-radius: 12px;
    text-decoration: none;
    text-align: left;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    min-width: 320px;
  }

  .btn:hover {
    background: rgba(212, 175, 55, 0.05);
    border-color: var(--primary-gold);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .icon { font-size: 2rem; }
  
  .text { display: flex; flex-direction: column; }
  .text strong { color: #fff; font-size: 1.1rem; margin-bottom: 0.2rem; }
  .text small { color: var(--text-dim); font-size: 0.85rem; }

  /* コンテンツセクション */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section { padding: 6rem 0; }
  
  .section-header {
    margin-bottom: 4rem;
    border-left: 4px solid var(--primary-gold);
    padding-left: 1.5rem;
  }

  .section-title {
    font-size: 2rem;
    margin: 0;
  }
  
  .section-title.centered { text-align: center; margin-bottom: 3rem; border: none; }

  .section-desc { color: var(--text-dim); margin-top: 0.5rem; }

  .hub-grid {
    display: grid;
    /* min-content 幅に引っ張られて左右列が微妙にズレるのを防ぐ */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .hub-card {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.02);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    /* CSS Grid の縮小時に中身の最小幅が原因で溢れ/ズレるのを抑制 */
    min-width: 0;
    margin-top: 0; /* Starlight の @layer content-gap リセット */
  }

  .hub-label {
    font-size: 0.8rem;
    letter-spacing: 0.08rem;
    color: var(--primary-gold);
  }

  .hub-card h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .hub-card p {
    margin: 0;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .hub-entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .hub-entries li {
    padding-left: 0.75rem;
    border-left: 2px solid rgba(212, 175, 55, 0.35);
  }

  .hub-entries a {
    color: #fff;
    text-decoration: none;
    font-size: 0.88rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s;
  }

  .hub-entries a:hover {
    color: var(--primary-gold);
    text-decoration: underline;
  }

  .hub-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
  }

  .hub-link {
    text-decoration: none;
    color: var(--primary-gold);
    font-weight: bold;
  }

  .hub-count {
    color: var(--text-dim);
    font-size: 0.85rem;
  }

  .posts-grid--latest {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .load-more-container {
    display: flex;
    justify-content: center;
    margin-top: 4rem;
  }

  .btn-load-more {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--primary-gold);
    color: #fff;
    padding: 1.2rem 3rem;
    border-radius: 50px;
    font-family: var(--font-ud-mincho);
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-load-more:hover {
    background: var(--primary-gold);
    color: #000;
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(212, 175, 55, 0.2);
  }

  .count-info {
    font-size: 0.8rem;
    opacity: 0.7;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .post-card {
    background: var(--bg-mocha);
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.05);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
    overflow: hidden;
    position: relative; /* 全面クリックの基準 */
    margin-top: 0; /* Starlight の @layer content-gap リセット */
  }

  .post-card:hover {
    border-color: var(--primary-gold);
    box-shadow: 0 20px 40px rgba(0,0,0,0.6);
  }

  .card-image-box {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
    z-index: 2;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .post-card:hover .card-img {
    transform: scale(1.05);
  }

  /* 記事詳細へのリンクをカード全体に広げる */
  .read-more::after {
    content: "";
    position: absolute;
    inset: 0; 
    z-index: 1;
    cursor: pointer;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
    letter-spacing: 0.1rem;
    position: relative;
    z-index: 2;
  }

  .card-content {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    /* ここに position: relative を入れると、全面クリックがこの範囲に限定されるため、入れない */
  }

  .post-card h3 { 
    font-size: 1.5rem; 
    margin-top: 0; 
    line-height: 1.4; 
    color: #fff; 
    position: relative; 
    z-index: 2; /* リンクの上に乗せて、ホバー効果やテキスト選択を可能に（任意） */
  }

  .post-card p { 
    color: var(--text-dim); 
    flex-grow: 1; 
    letter-spacing: 0.05rem; 
    line-height: 1.8;
    position: relative;
    z-index: 2;
  }

  .card-footer { 
    margin-top: 2rem; 
    position: relative;
    z-index: 2;
  }

  .read-more {
    color: var(--primary-gold);
    text-decoration: none;
    font-weight: bold;
    font-size: 0.85rem;
    letter-spacing: 0.1rem;
    transition: color 0.3s;
  }

  .read-more:hover {
    color: #fff;
    text-decoration: underline;
  }

  /* カテゴリピル */
  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .pill {
    background: rgba(255,255,255,0.03);
    padding: 1rem 2rem;
    border-radius: 50px;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid rgba(255,255,255,0.1);
    transition: all 0.3s;
  }

  .pill:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--primary-gold);
  }

  .pill:hover .pill-name { color: #fff; }
  .pill:hover .pill-count { color: var(--primary-gold); }

  .pill-name { color: #fff; font-weight: bold; font-size: 0.9rem; }
  .pill-count { color: var(--primary-gold); font-size: 0.8rem; }

  @media (max-width: 768px) {
    h1 { font-size: 2.8rem; }
    .action-branch { flex-direction: column; align-items: center; }
    .btn { min-width: 100%; }
    .hub-grid { grid-template-columns: 1fr; }
    .posts-grid--latest { grid-template-columns: 1fr; }
  }
</style>
