# 旧Hugoサイトのタクソノミページ・RSSフィード跡地
# Astro移行後は該当ページ自体が存在せず、今後も作る予定がないため
# 単純な404ではなく410 Gone（恒久的に削除）を明示してGoogleの索引除去を促す（2026-09-05）
RewriteEngine On
RewriteRule ^tags/ - [G,L]
RewriteRule ^categories/ - [G,L]
RewriteRule ^index\.xml$ - [G,L]
RewriteRule ^posts/page/ - [G,L]

# ── 恒久リダイレクト（astro.config.mjsのredirects設定をApache側で本物の301として実体化） ──────
# Astroの静的ビルドはredirectsをmeta refresh（200+noindex+canonical）としてしか出力できず、
# Googlebotがリダイレクト先・除外指示を認識するのにHTML解析が必要でクロール負荷が重い。
# 同じマッピングを301ヘッダーとして直接返すことで、クロール予算の消費を抑え評価移譲を速める（2026-09-25）
# ※ astro.config.mjsのredirectsを変更・追加した場合は、このブロックも合わせて更新すること
RewriteRule ^$ /ja/ [R=301,L]
